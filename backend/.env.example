# IDRestore AI Environment Configuration
# Set your Google Gemini API key below to enable live multimodal optical evaluation.
# If omitted, IDRestore AI will automatically and seamlessly run in offline OpenCV heuristic mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Application Configuration
APP_NAME=IDRestore AI
ENVIRONMENT=development
DEBUG=true

# Storage and Limits
MAX_FILE_SIZE_MB=25
MAX_IMAGE_DIMENSION=4096
DEFAULT_RETENTION_DAYS=30
DATABASE_URL=sqlite:///./idrestore.db
